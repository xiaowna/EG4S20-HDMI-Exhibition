proc hdmi_gui_opt_place {prj_name hdmi_root} {
  if {[get_param gate eram_init] ne "on" || [get_param gate opt_area] ne "high" || [get_param gate pack_effort] ne "high"} {
    error "HDMI: synthesis database has the wrong profile; rerun Syn Opt from Read Design"
  }
  set_param place pr_strategy 5
  set_param place effort high
  set_param place hfn_opt_effort high
  set_param place opt_timing high
  set_param place post_place_opt high
  set_param route post_route_opt high
  set_param route effort routability
  puts "HDMI_GUI_PLACE_PROFILE pr_strategy=[get_param place pr_strategy] route_effort=[get_param route effort]"
  set hdmi_receipt [open .hdmi_gui_opt_place.profile w]
  puts $hdmi_receipt [list stage opt_place root $hdmi_root checked_at [clock seconds]]
  close $hdmi_receipt
}
proc hdmi_gui_opt_route {prj_name hdmi_root} {
  set_param route post_route_opt high
  set_param route effort routability
  puts "HDMI_GUI_ROUTE_PROFILE effort=[get_param route effort]"
  set hdmi_receipt [open .hdmi_gui_opt_route.profile w]
  puts $hdmi_receipt [list stage opt_route root $hdmi_root checked_at [clock seconds]]
  close $hdmi_receipt
}
proc hdmi_gui_bitgen {prj_name hdmi_root} {
  set hdmi_checked_root $hdmi_root
  for {set hdmi_search 0} {$hdmi_search<8 && ![file isfile [file join $hdmi_checked_root tools project_setup.tcl]]} {incr hdmi_search} {
    set hdmi_checked_root [file dirname $hdmi_checked_root]
  }
  if {![file isfile [file join $hdmi_checked_root tools project_setup.tcl]]} {error "HDMI project timing checker not found"}
  source [file join $hdmi_checked_root tools project_setup.tcl]
  hdmi_require_timing ${prj_name}_pr.timing
  puts {HDMI_GUI_BITGEN_TIMING_PASSED}
  set hdmi_receipt [open .hdmi_gui_bitgen.profile w]
  puts $hdmi_receipt [list stage bitgen root $hdmi_root checked_at [clock seconds]]
  close $hdmi_receipt
}
